# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_BASE_URL=
CLOUDINARY_FOLDER_DEFAULT=
CLOUDINARY_FOLDER_PRODUCTS=
CLOUDINARY_FOLDER_BANNERS=
CLOUDINARY_FOLDER_AVATARS=
CLOUDINARY_API_BASE_URL=https://api.cloudinary.com/v1_1
CLOUDINARY_FOLDER_DEFAULT=meow_coffee
CLOUDINARY_FOLDER_PRODUCTS=product_cf
CLOUDINARY_FOLDER_BANNERS=banner
CLOUDINARY_FOLDER_AVATARS=avt_user

# EmailJS (OTP & Welcome Email)
EMAILJS_API_URL=https://api.emailjs.com/api/v1.0/email/send
EMAILJS_ORIGIN=http://localhost
EMAILJS_SERVICE_ID=
EMAILJS_OTP_TEMPLATE_ID=
EMAILJS_WELCOME_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# VietQR (Thanh toan chuyen khoan)
VIETQR_API_BASE_URL=https://api.vietqr.io/image
VIETQR_BANK_BIN=your_bank_bin
VIETQR_ACCOUNT_NUMBER=your_account_number
VIETQR_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
VIETQR_TEMPLATE_ID=your_template_id

# Thử OTP bằng số điện thoại test khai báo trong Firebase Console (không gửi SMS thật,
# bỏ reCAPTCHA). Chỉ có tác dụng ở bản debug. Để false khi đã bật Blaze và gửi SMS thật.
AUTH_PHONE_TEST_MODE=true

# Cloudflare Worker – API bán online (thư mục worker/)
# Local: http://10.0.2.2:8787 (máy ảo Android) hoặc http://localhost:8787
ORDER_API_BASE_URL=https://meow-coffee-api.your-subdomain.workers.dev

# Firebase
# Android dùng FIREBASE_API_KEY + FIREBASE_ANDROID_APP_ID
# iOS/macOS dùng FIREBASE_IOS_*; Web/Windows/Linux dùng FIREBASE_WEB_*
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_STORAGE_BUCKET=your_storage_bucket
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_API_KEY=your_android_api_key
FIREBASE_ANDROID_APP_ID=your_android_app_id
FIREBASE_IOS_API_KEY=your_ios_api_key
FIREBASE_IOS_APP_ID=your_ios_app_id
FIREBASE_IOS_BUNDLE_ID=your_ios_bundle_id
FIREBASE_WEB_API_KEY=your_web_api_key
FIREBASE_WEB_APP_ID=your_web_app_id
