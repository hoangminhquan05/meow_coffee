rules_version = '2';

// Firestore Security Rules – Meow Coffee.
// Bán tại quán: docs/ke-hoach-ban-tai-quan.md mục 5.
// Bán online:   docs/ke-hoach-ban-online.md mục 10.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().is_active == true;
    }
    function isAdmin() { return isActive() && me().role == 'admin'; }
    function isStaff() { return isActive() && me().role == 'staff'; }
    // Người bán tại quầy: nhân viên hoặc admin (không gồm khách, shipper).
    function isSeller() { return isActive() && me().role in ['staff', 'admin']; }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Sản phẩm: ai đăng nhập cũng đọc; NV/admin bật/tắt hết hàng (Q9); admin toàn quyền.
    match /products/{id} {
      allow read: if isActive();
      allow update: if isSeller() && onlyChanges(['is_available']);
      allow create, update, delete: if isAdmin();
    }

    // Cài đặt quán: ai đăng nhập cũng đọc; admin sửa toàn bộ;
    // nhân viên chỉ bật/tắt tạm ngưng nhận đơn online.
    match /settings/shop {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow update: if isStaff()
        && onlyChanges(['online_paused', 'updated_at', 'updated_by'])
        && request.resource.data.updated_by.id == request.auth.uid;
    }

    // Số shipper đang trong ca (Worker ghi) – khách đọc để biết có đặt đơn được không (O30).
    match /settings/shop_live {
      allow read: if isActive();
      allow write: if false;
    }

    // Trạng thái shipper (bước 8). Vào/ra ca qua Worker (POST /shipper/shift);
    // trong ca shipper tự gửi GPS: chỉ đổi vị trí, thời điểm = giờ server.
    match /shipper_status/{uid} {
      allow read: if isSeller() || (isActive() && request.auth.uid == uid);
      allow update: if isActive() && request.auth.uid == uid
        && me().role == 'shipper'
        && resource.data.on_shift == true
        && onlyChanges(['location', 'location_updated_at'])
        && request.resource.data.location.lat is number
        && request.resource.data.location.lng is number
        && request.resource.data.location.lat >= -90 && request.resource.data.location.lat <= 90
        && request.resource.data.location.lng >= -180 && request.resource.data.location.lng <= 180
        && request.resource.data.location_updated_at == request.time;
      allow create, delete: if false;
    }

    // Nhật ký ca shipper (Worker ghi) – cho báo cáo của admin.
    match /shipper_shifts/{id} {
      allow read: if isAdmin()
        || (isActive() && resource.data.shipper.id == request.auth.uid);
      allow write: if false;
    }

    match /banners/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Bàn: NV/admin đổi trạng thái (L11); admin thêm/sửa/xóa.
    match /tables/{id} {
      allow read: if isSeller();
      allow update: if isSeller() && onlyChanges(['status', 'updated_at']);
      allow create, update, delete: if isAdmin();
    }

    // Bộ đếm mã đơn tại quầy theo ngày: chỉ tăng 1 mỗi lần.
    // (Bộ đếm online `online_*` do Cloudflare Worker ghi bằng service account.)
    match /counters/{id} {
      allow read: if isSeller();
      allow create: if isSeller() && id.matches('orders_[0-9]{8}')
        && request.resource.data.seq == 1;
      allow update: if isSeller() && id.matches('orders_[0-9]{8}')
        && request.resource.data.seq == resource.data.seq + 1;
    }

    // ---- Đơn online: NV/admin xử lý (bước 7, mục 4 kế hoạch online) ----
    // Mỗi lần đổi trạng thái thêm đúng 1 dòng status_history do chính người bấm.
    function historyAppended() {
      let n = resource.data.status_history.size();
      let h = request.resource.data.status_history;
      return h.size() == n + 1
        && h[n].status == request.resource.data.status
        && h[n].by.id == request.auth.uid;
    }
    // Đơn đã trả trước: phải ghi cần hoàn tiền (O17/O32); chưa trả: không đụng refund.
    function refundRecorded() {
      let a = request.resource.data;
      return resource.data.payment_status == 'paid'
        ? (a.refund.required == true && a.refund.done == false
            && a.refund.amount is int && a.refund.amount > 0)
        : a.get('refund', null) == resource.data.get('refund', null);
    }
    // Xác nhận → bắt đầu pha → pha xong.
    function staffAdvanceOk() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      return ((from == 'pending' && to == 'confirmed')
              || (from == 'confirmed' && to == 'preparing')
              || (from == 'preparing' && to == 'ready'))
        && onlyChanges(['status', 'status_history', 'updated_at'])
        && historyAppended();
    }
    // Từ chối / hủy trước khi shipper lấy hàng.
    function staffCancelOk() {
      let a = request.resource.data;
      return resource.data.status in ['pending', 'confirmed', 'preparing', 'ready']
        && a.status == 'cancelled'
        && a.cancel_reason is string && a.cancel_reason.size() > 0
        && a.cancelled_by.id == request.auth.uid
        && onlyChanges(['status', 'status_history', 'payment_status', 'cancelled_at',
                        'cancelled_by', 'cancel_reason', 'refund', 'updated_at'])
        && historyAppended()
        && (resource.data.payment_status == 'paid'
              ? a.payment_status == 'refunded'
              : a.payment_status == resource.data.payment_status)
        && refundRecorded();
    }
    // Bỏ món (O16): tổng tiền phải khớp, còn ít nhất 1 món, ghi item_changes.
    function staffRemoveItemOk() {
      let b = resource.data;
      let a = request.resource.data;
      let n = b.get('item_changes', []).size();
      return b.status in ['pending', 'confirmed', 'preparing']
        && a.status == b.status
        && onlyChanges(['items', 'subtotal', 'total', 'item_changes', 'refund', 'updated_at'])
        && a.items is list && a.items.size() >= 1 && a.items.size() <= b.items.size()
        && a.subtotal is int && a.subtotal > 0 && a.subtotal < b.subtotal
        && a.total == a.subtotal - b.discount + b.delivery.fee
        && a.item_changes.size() == n + 1
        && a.item_changes[n].by.id == request.auth.uid
        && a.item_changes[n].reason is string && a.item_changes[n].reason.size() > 0
        && refundRecorded();
    }
    // Admin đã chuyển khoản hoàn tiền.
    function adminRefundDoneOk() {
      let a = request.resource.data.refund;
      let b = resource.data.get('refund', {});
      return b.get('required', false) == true && b.get('done', true) == false
        && onlyChanges(['refund'])
        && a.required == true && a.done == true
        && a.amount == b.amount
        && a.done_by.id == request.auth.uid;
    }

    match /orders/{id} {
      // Đơn online do Cloudflare Worker tạo (service account, bỏ qua Rules);
      // NV/admin đọc mọi đơn online; khách chỉ đọc đơn online của chính mình.
      allow read: if isAdmin()
        || (isSeller() && resource.data.get('seller', {}).get('id', '') == request.auth.uid)
        || (isSeller() && resource.data.channel == 'online')
        || (isActive() && resource.data.channel == 'online'
            && resource.data.customer.id == request.auth.uid);

      // Xử lý đơn online (bước 7).
      allow update: if isSeller() && resource.data.channel == 'online'
        && (staffAdvanceOk() || staffCancelOk() || staffRemoveItemOk());
      allow update: if isAdmin() && resource.data.channel == 'online'
        && adminRefundDoneOk();

      // Tạo đơn tại quán: thu tiền trước (Q2); tại quán bắt buộc có bàn (Q13).
      allow create: if isSeller()
        && request.resource.data.channel == 'in_store'
        && request.resource.data.status == 'completed'
        && request.resource.data.payment_status == 'paid'
        && request.resource.data.seller.id == request.auth.uid
        && request.resource.data.total == request.resource.data.subtotal - request.resource.data.discount
        && (request.resource.data.fulfillment == 'takeaway'
              ? request.resource.data.table_number == null
              : (request.resource.data.fulfillment == 'dine_in'
                  && request.resource.data.table_number is int));

      // Hủy đơn (Q7): admin mọi lúc; nhân viên chỉ đơn của mình trong 30 phút.
      // Không được sửa trường nào khác của đơn (Q5).
      allow update: if isSeller()
        && resource.data.status == 'completed'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.payment_status == 'refunded'
        && request.resource.data.cancel_reason is string
        && request.resource.data.cancel_reason.size() > 0
        && request.resource.data.cancelled_by.id == request.auth.uid
        && onlyChanges(['status', 'payment_status', 'cancelled_at', 'cancelled_by', 'cancel_reason'])
        && (isAdmin()
            || (resource.data.seller.id == request.auth.uid
                && request.time < resource.data.created_at + duration.value(30, 'm')));

      allow delete: if false;
    }

    // Người dùng tự sửa hồ sơ. Cờ đã xác minh chỉ được bật khi Firebase Auth
    // xác nhận thật: SĐT trong ID token trùng phone_e164 / email_verified = true.
    function selfUpdateOk() {
      let d = request.resource.data;
      let keys = d.diff(resource.data).affectedKeys();
      let tokenPhone = request.auth.token.get('phone_number', '');
      return keys.hasOnly(['name', 'phone', 'phone_e164', 'avt_url',
                           'phone_verified', 'email_verified'])
        && (!keys.hasAny(['phone_verified', 'phone_e164'])
            || d.get('phone_verified', false) == false
            || tokenPhone == d.get('phone_e164', ''))
        && (!keys.hasAny(['email_verified'])
            || d.email_verified == false
            || request.auth.token.get('email_verified', false) == true)
        // Khách đổi SĐT phải đổi kèm phone_e164 đã xác minh OTP.
        && (resource.data.role != 'customer'
            || !keys.hasAny(['phone'])
            || (d.get('phone_verified', false) == true
                && tokenPhone == d.get('phone_e164', '')));
    }

    // Đọc: chính mình (kể cả khi bị khóa, để app biết và đăng xuất) hoặc admin.
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      // Khách tự đăng ký: chỉ tạo được hồ sơ khách, chưa xác minh.
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == 'customer'
            && request.resource.data.is_active == true
            && request.resource.data.phone_verified == false
            && request.resource.data.email_verified == false
            && request.resource.data.email == request.auth.token.email);
      allow update: if isAdmin()
        || (isActive() && request.auth.uid == uid && selfUpdateOk());
      allow delete: if isAdmin();
    }

    // Sổ địa chỉ (O7): chỉ chủ tài khoản; dữ liệu phải đủ và có toạ độ hợp lệ.
    // Giới hạn 3 địa chỉ kiểm ở app (Rules không đếm được tài liệu).
    function validAddress() {
      let d = request.resource.data;
      return d.keys().hasAll(['label', 'receiver_name', 'receiver_phone',
                              'province', 'ward', 'street', 'location', 'is_default'])
        && d.label in ['home', 'work', 'other']
        && d.receiver_name is string && d.receiver_name.size() > 0
        && d.receiver_phone is string && d.receiver_phone.size() > 0
        && d.street is string && d.street.size() > 0
        && d.province.code is int && d.ward.code is int
        && d.location.lat is number && d.location.lat >= -90 && d.location.lat <= 90
        && d.location.lng is number && d.location.lng >= -180 && d.location.lng <= 180
        && d.is_default is bool;
    }

    match /users/{uid}/addresses/{addressId} {
      allow read, delete: if isActive() && request.auth.uid == uid;
      allow create, update: if isActive() && request.auth.uid == uid && validAddress();
    }

    // Giỏ hàng online của khách (đồng bộ giữa các thiết bị): chỉ chủ tài khoản.
    // Chỉ lưu mã món/size/số lượng/ghi chú – giá do Worker tính khi đặt đơn.
    match /carts/{uid} {
      allow read, delete: if isActive() && request.auth.uid == uid;
      allow create, update: if isActive() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items', 'updated_at'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 30;
    }

    // Giao dịch ngân hàng từ SePay: Worker ghi (service account); chỉ admin xem.
    // Admin xử lý qua Worker (/admin/payments/{id}/resolve), không ghi thẳng.
    match /payment_transactions/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Collection dành cho bán online (chưa triển khai): chặn mặc định.
    match /chats/{document=**} {
      allow read, write: if false;
    }
  }
}
